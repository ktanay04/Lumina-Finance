# Place this file at the project root as `.env` (same folder as package.json).

MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/lumina_finance?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-long-random-string
PORT=5001
NODE_ENV=development

# Ask AI (Sarvam) — https://docs.sarvam.ai/api-reference-docs/api-guides-tutorials/chat-completion/overview
SARVAM_API_KEY=
# Optional: sarvam-30b (default) or sarvam-105b
# SARVAM_MODEL=sarvam-30b